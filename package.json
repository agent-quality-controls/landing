{
  "name": "agent-qc-landing-workspace",
  "private": true,
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null && git lfs install 2>/dev/null || true",
    "build": "pnpm -r --if-present run build",
    "test": "node --test tests/tooling/*.test.mjs",
    "lint": "pnpm --filter landing run lint && pnpm --filter @project/ui run lint",
    "lint:css": "stylelint 'apps/landing/src/**/*.css' 'packages/**/*.css'",
    "spell": "cspell '**/*.{ts,tsx,mts,js,mjs,json,md}'",
    "jscpd": "jscpd",
    "typecheck": "tsc --noEmit -p apps/landing/tsconfig.json && tsc --noEmit -p packages/ui/tsconfig.json"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@img/sharp-darwin-arm64",
      "@img/sharp-linux-x64",
      "unrs-resolver"
    ],
    "ignoredBuiltDependencies": [
      "sharp"
    ],
    "overrides": {
      "@eslint/js": "^9.0.0"
    }
  },
  "devDependencies": {
    "@double-great/stylelint-a11y": "3.4.9",
    "@next/eslint-plugin-next": "16.2.3",
    "cspell": "10.0.0",
    "eslint": "^9.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^5.0.0",
    "eslint-plugin-i18next": "6.1.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-regexp": "3.1.0",
    "eslint-plugin-sonarjs": "4.0.2",
    "eslint-plugin-tailwind-ban": "1.0.1",
    "eslint-plugin-unicorn": "64.0.0",
    "jscpd": "^4.0.8",
    "stylelint": "17.7.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-tailwindcss": "1.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
