{
  "name": "@project/ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "lint": "eslint --max-warnings 0 .",
    "lint:css": "stylelint --max-warnings 0 globals.css",
    "typecheck": "tsc --noEmit",
    "lint:packages": "syncpack lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spellcheck": "cspell . --no-progress --no-summary",
    "typecov": "type-coverage --at-least 100",
    "validate": "pnpm run lint && pnpm run typecheck && pnpm run lint:css && pnpm run lint:packages && pnpm run format:check && pnpm run spellcheck && pnpm run typecov"
  },
  "exports": {
    ".": "./src/index.ts",
    "./globals.css": "./globals.css",
    "./primitives": "./src/primitives/index.ts",
    "./blocks": "./src/blocks/index.ts",
    "./link": "./src/link.tsx"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@double-great/stylelint-a11y": "3.4.9",
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cspell": "10.0.0",
    "g3ts-eslint-plugin-style-policy": "0.1.3",
    "prettier": "3.8.3",
    "react": "^19",
    "react-dom": "^19",
    "stylelint": "17.7.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-tailwindcss": "1.0.1",
    "syncpack": "14.3.0",
    "type-coverage": "2.29.7",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cmdk": "^1.0.0",
    "lucide-react": "^0.577.0",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.0.0"
  }
}
